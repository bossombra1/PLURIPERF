# ---- Server ----
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Database ----
DB_PATH=./data/pluriperf.db

# ---- Auth ----
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TTL_MINUTES=60

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ---- Email (SMTP). Empty host = log to console in dev ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="PLURIPERF <no-reply@pluriperf.com>"
MAIL_CONTACT_TO=contact@pluriperf.com

# ---- Frontend ----
VITE_API_URL=/api
VITE_API_PROXY=http://localhost:4000
