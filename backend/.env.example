NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pluriperf
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-local-development
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TTL_MINUTES=60
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
APPOINTMENT_TIMEZONE=Africa/Abidjan
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=PLURIPERF International <no-reply@pluriperf.com>
MAIL_CONTACT_TO=contact@pluriperf.com
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL=false
